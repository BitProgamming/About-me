server {
    listen 80;
    server_name www.bibit.id;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name www.bibit.id;

    ssl_certificate /etc/ssl/certs/web.crt;
    ssl_certificate_key /etc/ssl/private/web.key;

    location / {
        proxy_pass http://192.168.10.2:8080;

        proxy_set_header Host $192.168.10.2:8080; >> add ip web server for host value
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_set_header X-Forwarded-Proto https;
    }
}
